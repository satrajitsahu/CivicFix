# CivicFix Backend Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/civicfix?retryWrites=true&w=majority

# JWT Secret Key
JWT_SECRET=YOUR_LONG_RANDOM_SECRET

# Optional: Initial Admin Seed Credentials
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_THIS_PASSWORD
